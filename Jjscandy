-- ------------------------------------------------------------
-- MAIN LOOP
-- ------------------------------------------------------------
local function detail(dist)
    local s = string.format("%s · %.0f studs", rubberStreak >= 3 and "Walk (auto)" or CONFIG.mode, dist)
    if CONFIG.autoSlow and throttle < 0.95 then s ..= string.format(" · x%.2f", throttle) end
    return s
end

local function farmOnce()
    if not state.running or state.busy or not hrp or not hrp.Parent or humanoid.Health <= 0 then return end
    state.busy = true

    local all, valid = scan(), {}
    for _, p in ipairs(all) do
        if not isCooling(p.pos) then valid[#valid + 1] = p end
    end

    -- nothing left at all: retreat home (once), then wait
    if #all == 0 then
        emptySince = emptySince or now()
        if CONFIG.returnHome and home and now() - emptySince > 2.5 and (hrp.Position - home).Magnitude > 8 then
            setStatus("Returning home", C.accent, detail((hrp.Position - home).Magnitude))
            local ok = moveTo({ { pos = home } })
            setStatus(ok and "At home" or "Couldn't reach home", ok and C.good or C.warn, "waiting for candy")
        else
            local atHome = home and (hrp.Position - home).Magnitude <= 8
            setStatus(atHome and "At home" or "No candy", atHome and C.good or C.warn, "waiting for candy")
        end
        state.busy = false
        return
    end
    emptySince = nil

    if #valid == 0 then
        setStatus("Cooldown", C.warn, "waiting for respawns")
        state.busy = false
        return
    end

    local origin = hrp.Position
    local vw = (CONFIG.mode == "Walk") and 1.5 or 0.5
    local function score(p)
        local d = p.pos - origin
        return Vector3.new(d.X, 0, d.Z).Magnitude + math.abs(d.Y) * vw
    end
    table.sort(valid, function(a, b) return score(a) < score(b) end)

    local target = valid[1]
    setStatus("Approaching", C.accent, detail((target.pos - origin).Magnitude))

    local moved, reason = moveTo(approachPoints(target))

    if moved and target.prompt.Parent then
        setStatus("Opening", C.accent, "")
        if activate(target) then
            cool(target.pos, CONFIG.cooldownSuccess)
            setStatus("Opened", C.good, "")
        else
            cool(target.pos, CONFIG.cooldownFail)
            setStatus("Didn't open", C.warn, "skipping for now")
        end
    elseif not moved and state.running then
        if reason == "rubber" then
            cool(target.pos, 3)
            setStatus("Rubber-banded", C.warn, string.format("slowing to x%.2f, re-planning", throttle))
        else
            cool(target.pos, CONFIG.cooldownFail)
            setStatus("Unreachable", C.warn, "skipping for now")
        end
    end

    state.busy = false
end

task.spawn(function()
    while state.alive do
        task.wait(0.1)
        local ok = pcall(farmOnce)
        if not ok then state.busy = false; setNoclip(false) end
    end
end)
