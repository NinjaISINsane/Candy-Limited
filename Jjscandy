-- ------------------------------------------------------------
-- HELPERS
-- ------------------------------------------------------------
local function isHidden(pos)
    return math.abs(pos.X) > 1e5 or math.abs(pos.Y) > 1e5 or math.abs(pos.Z) > 1e5
end

local function basePart(obj)
    while obj and not obj:IsA("BasePart") do obj = obj.Parent end
    return obj
end

local function hover() return humanoid.HipHeight + hrp.Size.Y / 2 end

local function cool(pos, duration)
    cooldowns[pos] = { t = now() + duration, r = CONFIG.cooldownRadius }
end

local function isCooling(pos)
    for p, c in pairs(cooldowns) do
        if c.t < now() then
            cooldowns[p] = nil
        elseif (p - pos).Magnitude <= c.r then
            return true
        end
    end
    return false
end

-- ------------------------------------------------------------
-- PROMPT REGISTRY (event driven)
-- ------------------------------------------------------------
local registry = {}
local function track(o) if o:IsA("ProximityPrompt") then registry[o] = true end end
for _, o in ipairs(workspace:GetDescendants()) do track(o) end
conns[#conns + 1] = workspace.DescendantAdded:Connect(track)
conns[#conns + 1] = workspace.DescendantRemoving:Connect(function(o) registry[o] = nil end)

local function scan()
    local want, out = CONFIG.actionText:lower(), {}
    for prompt in pairs(registry) do
        if prompt.Enabled and prompt.ActionText:lower() == want then
            local part = basePart(prompt.Parent)
            if part and part:IsDescendantOf(workspace) and not isHidden(part.Position) then
                out[#out + 1] = { prompt = prompt, part = part, pos = part.Position }
            end
        end
    end
    return out
end

-- ------------------------------------------------------------
-- NOCLIP (only used by the last-resort Hop)
-- ------------------------------------------------------------
local noclipConn
local function setNoclip(on)
    if on and not noclipConn then
        noclipConn = RunService.Stepped:Connect(function()
            if not character then return end
            for _, p in ipairs(character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    elseif not on and noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
end

-- ------------------------------------------------------------
-- WORLD QUERIES
-- ------------------------------------------------------------
local function rayParams(ignore)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.RespectCanCollide = true
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then list[#list + 1] = p.Character end
    end
    if ignore then list[#list + 1] = ignore end
    rp.FilterDescendantsInstances = list
    return rp
end

local function rayClear(a, b, ignore)
    local d = b - a
    if d.Magnitude < 0.1 then return true end
    return workspace:Raycast(a, d, rayParams(ignore)) == nil
end

-- body-width clearance: no walls between a and b
local function bodyClear(a, b)
    local d = b - a
    if d.Magnitude < 0.1 then return true end
    local ok, hit = pcall(function() return workspace:Spherecast(a, 1.5, d, rayParams()) end)
    if not ok then return rayClear(a, b) end
    return hit == nil
end

-- floor exists along the whole leg (no flying off ledges / over voids)
local function groundedLine(a, b)
    local len   = (b - a).Magnitude
    local steps = math.clamp(math.ceil(len / 6), 1, 60)
    local rp    = rayParams()
    local reach = hover() + 6
    for i = 0, steps do
        local p = a:Lerp(b, i / steps)
        if not workspace:Raycast(p, Vector3.new(0, -reach, 0), rp) then return false end
    end
    return true
end

local function legSafe(a, b) return bodyClear(a, b) and groundedLine(a, b) end

-- ------------------------------------------------------------
-- APPROACH POINTS (stand OUTSIDE, in front of the door)
-- ------------------------------------------------------------
local function approachPoints(t)
    local part  = t.part
    local stand = math.clamp((t.prompt.MaxActivationDistance or 10) * 0.5, 2.5, 5)
    local cf    = part.CFrame
    local flat  = function(v) return Vector3.new(v.X, 0, v.Z) end

    local dirs = { cf.LookVector, -cf.LookVector, cf.RightVector, -cf.RightVector, hrp.Position - t.pos }
    local list, rp = {}, rayParams(part)

    for _, d in ipairs(dirs) do
        d = flat(d)
        if d.Magnitude > 0.2 then
            local p = t.pos + d.Unit * stand
            local hit = workspace:Raycast(Vector3.new(p.X, t.pos.Y + 2, p.Z), Vector3.new(0, -30, 0), rp)
            p = hit and Vector3.new(p.X, hit.Position.Y + hover(), p.Z) or Vector3.new(p.X, t.pos.Y, p.Z)

            if rayClear(p, t.pos, part) then
                local roofed = workspace:Raycast(p, Vector3.new(0, 40, 0), rp) ~= nil
                list[#list + 1] = { pos = p, score = (p - hrp.Position).Magnitude + (roofed and 20 or 0) }
            end
        end
    end

    table.sort(list, function(a, b) return a.score < b.score end)
    if #list == 0 then
        local d = flat(hrp.Position - t.pos)
        d = d.Magnitude > 0.2 and d.Unit or Vector3.new(0, 0, 1)
        list[1] = { pos = t.pos + d * stand, score = 0 }
    end
    return list
end

-- ------------------------------------------------------------
-- MOVEMENT PRIMITIVES
-- ------------------------------------------------------------
local RUBBER_DIST = 12

-- returns ok, reason ("stopped" | "rubber")
local function fly(points)
    local segLen, total = {}, 0
    for i = 2, #points do
        segLen[i] = (points[i] - points[i - 1]).Magnitude
        total += segLen[i]
    end
    if total < 0.1 then return true end

    local expected  = hrp.Position
    local travelled = 0
    local startT    = now()

    while travelled < total do
        if not active() or not hrp or not hrp.Parent then return false, "stopped" end
        local dt = RunService.Heartbeat:Wait()
        if not hrp.Parent then return false, "stopped" end

        -- server yanked us back? stop immediately and re-plan from here
        if (hrp.Position - expected).Magnitude > RUBBER_DIST then return false, "rubber" end

        local spd  = effSpeed()
        local ramp = math.clamp((now() - startT) / 0.3, 0.25, 1)
        local ease = math.clamp((total - travelled) / math.max(spd * 0.25, 1), 0.25, 1)
        travelled  = math.min(total, travelled + spd * math.min(ramp, ease) * dt)

        local remain, pos = travelled, points[#points]
        for i = 2, #points do
            if remain <= segLen[i] then
                pos = points[i - 1]:Lerp(points[i], segLen[i] > 0 and remain / segLen[i] or 1)
                break
            end
            remain -= segLen[i]
        end

        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(pos) * (hrp.CFrame - hrp.CFrame.Position)
        expected = pos
    end
    return true
end

-- last resort: lowest altitude where up / across / down are clear (clips)
local function hop(goal)
    setNoclip(true)
    local start = hrp.Position
    local base  = math.max(start.Y, goal.Y)
    local pts
    for _, extra in ipairs({ 0, 12, 30, 60, 100 }) do
        local y = base + extra
        local a = Vector3.new(start.X, y, start.Z)
        local b = Vector3.new(goal.X,  y, goal.Z)
        if bodyClear(start, a) and bodyClear(a, b) and bodyClear(b, goal) then
            pts = { start, a, b, goal }
            break
        end
    end
    if not pts then
        local y = base + CONFIG.hopHeight
        pts = { start, Vector3.new(start.X, y, start.Z), Vector3.new(goal.X, y, goal.Z), goal }
    end
    local ok, reason = fly(pts)
    setNoclip(false)
    return ok, reason
end

-- ------------------------------------------------------------
-- PATHFINDING
-- ------------------------------------------------------------
local PROFILES = {
    { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, AgentCanClimb = false },
    { AgentRadius = 1, AgentHeight = 3, AgentCanJump = true, AgentCanClimb = true  },
}

local function computePath(from, to)
    for _, prof in ipairs(PROFILES) do
        local params = table.clone(prof)
        params.WaypointSpacing = math.max(4, math.min(20, effSpeed() / 12))
        local path = PathfindingService:CreatePath(params)
        local ok = pcall(path.ComputeAsync, path, from, to)
        if ok and path.Status == Enum.PathStatus.Success then
            return path, path:GetWaypoints()
        end
    end
end

local function pathPoints(wps)
    local pts, h = { hrp.Position }, Vector3.new(0, hover(), 0)
    for i = 2, #wps do pts[#pts + 1] = wps[i].Position + h end
    return pts
end

-- cut corners only where the shortcut is provably wall-free and has floor
local function simplify(pts)
    local out, i = { pts[1] }, 1
    while i < #pts do
        local j = math.min(#pts, i + 8)
        while j > i + 1 and not legSafe(pts[i], pts[j]) do j -= 1 end
        out[#out + 1] = pts[j]
        i = j
    end
    return out
end

local function pathLength(wps)
    local len = 0
    for i = 2, #wps do len += (wps[i].Position - wps[i - 1].Position).Magnitude end
    return len
end

-- returns ok, reason
local function walk(path, wps)
    local oldSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = math.clamp(CONFIG.speed, 16, 400)

    local blockedIdx
    local conn = path.Blocked:Connect(function(i) blockedIdx = i end)
    local function finish(ok, reason)
        conn:Disconnect()
        if humanoid and humanoid.Parent then humanoid.WalkSpeed = oldSpeed end
        return ok, reason
    end

    local budget = math.max(CONFIG.pathTimeout, pathLength(wps) / math.max(CONFIG.speed, 16) * 2 + 4)
    local t0 = now()

    for i = 2, #wps do
        local wp  = wps[i]
        local tol = (i == #wps) and 2.5 or 5
        if wp.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
        humanoid:MoveTo(wp.Position)

        local wpStart, lastPos, lastChk, stuck = now(), hrp.Position, now(), 0
        while true do
            if not active() or not hrp.Parent then return finish(false, "stopped") end
            if now() - t0 > budget then return finish(false, "timeout") end
            if blockedIdx and blockedIdx >= i then return finish(false, "blocked") end

            local d = hrp.Position - wp.Position
            if Vector3.new(d.X, d.Y * 0.35, d.Z).Magnitude <= tol then break end

            local nxt = wps[i + 1]
            if nxt and d.Magnitude < 10
               and (hrp.Position - nxt.Position).Magnitude < (wp.Position - nxt.Position).Magnitude - 1 then
                break
            end

            if now() - lastChk >= 0.5 then
                if (hrp.Position - lastPos).Magnitude < 1 then
                    stuck += 1
                    humanoid.Jump = true
                    humanoid:MoveTo(wp.Position)
                    if stuck >= 3 then return finish(false, "stuck") end
                else
                    stuck = 0
                end
                lastPos, lastChk = hrp.Position, now()
            end

            if now() - wpStart > CONFIG.waypointTimeout then break end
            task.wait(0.03)
        end
    end
    return finish(true)
end

-- ------------------------------------------------------------
-- TRAVEL (shared by candy runs and going home)
-- ------------------------------------------------------------
local function moveInner(cands)
    local mode = CONFIG.mode
    if rubberStreak >= 3 and mode ~= "Instant" then mode = "Walk" end -- keeps getting reset: walk for real

    if mode == "Instant" then
        hrp.CFrame = CFrame.new(cands[1].pos)
        return true
    end
    if mode == "Hop" then return hop(cands[1].pos) end

    local lastReason = "nopath"
    for i = 1, math.min(3, #cands) do
        local c = cands[i].pos

        -- 1) direct line, only if wall-free and has floor the whole way
        if mode == "Smart" and legSafe(hrp.Position, c) then
            return fly({ hrp.Position, c })
        end

        -- 2) real navmesh route
        for _ = 1, CONFIG.retries + 1 do
            if not active() then return false, "stopped" end
            local path, wps = computePath(hrp.Position, c)
            if not path then break end

            if mode == "Walk" then
                local ok, reason = walk(path, wps)
                if ok then return true end
                if reason == "stopped" then return false, "stopped" end
                lastReason = reason
                setStatus("Re-pathing", nil, reason)
            else
                return fly(simplify(pathPoints(wps)))
            end
        end
    end

    -- 3) last resort: clip over it
    if CONFIG.allowClip then return hop(cands[1].pos) end
    return false, lastReason
end

local function moveTo(cands)
    local pok, ok, reason = pcall(moveInner, cands)
    setNoclip(false)
    if not pok then return false, "error" end

    if ok then
        rubberStreak = 0
        throttle = math.min(1, throttle + 0.08)
    elseif reason == "rubber" then
        rubberStreak += 1
        if CONFIG.autoSlow then throttle = math.max(0.2, throttle * 0.55) end
    end
    if onThrottle then onThrottle() end
    return ok, reason
end

-- ------------------------------------------------------------
-- OPENING THE DOOR (verified, 3 methods)
-- ------------------------------------------------------------
local learn = { fires = 0, changes = 0 }

local function isDone(prompt, action)
    return not prompt.Parent
        or not prompt:IsDescendantOf(workspace)
        or not prompt.Enabled
        or prompt.ActionText:lower() ~= action
end

local function inRange(t)
    return (hrp.Position - t.pos).Magnitude <= math.max(t.prompt.MaxActivationDistance, 4) * 0.9
end

local function closeIn(t)
    if inRange(t) then return end
    local flat = Vector3.new(hrp.Position.X - t.pos.X, 0, hrp.Position.Z - t.pos.Z)
    flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    local goal = Vector3.new(t.pos.X, hrp.Position.Y, t.pos.Z) + flat * 2
    if legSafe(hrp.Position, goal) then fly({ hrp.Position, goal }) end
end

local function face(pos)
    local p = hrp.Position
    hrp.CFrame = CFrame.lookAt(p, Vector3.new(pos.X, p.Y, pos.Z))
end

local function activate(t)
    local prompt = t.prompt
    local action = prompt.ActionText:lower()
    local hold   = prompt.HoldDuration
    pcall(function() prompt.HoldDuration = 0 end)

    closeIn(t)
    face(t.pos)
    task.wait(0.05)

    learn.fires += 1
    local verify   = CONFIG.verify and not (learn.fires > 3 and learn.changes == 0)
    local attempts = verify and 3 or 1

    for attempt = 1, attempts do
        if isDone(prompt, action) then break end
        if attempt > 1 then setStatus(("Retrying open (%d/3)"):format(attempt), nil) end

        if attempt == 1 then
            for i = 1, CONFIG.clickBurst do
                task.spawn(function() pcall(fireproximityprompt, prompt, 1) end)
                if i < CONFIG.clickBurst then task.wait(0.02) end
            end
        elseif attempt == 2 then
            pcall(function()
                prompt:InputHoldBegin()
                task.wait(0.15)
                prompt:InputHoldEnd()
            end)
        else
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                vim:SendKeyEvent(true,  prompt.KeyboardKeyCode, false, game)
                task.wait(0.2)
                vim:SendKeyEvent(false, prompt.KeyboardKeyCode, false, game)
            end)
        end

        local t0 = now()
        while verify and now() - t0 < 0.45 and not isDone(prompt, action) do task.wait(0.05) end
    end

    local done = isDone(prompt, action)
    if done then learn.changes += 1 end
    pcall(function() if prompt.Parent then prompt.HoldDuration = hold end end)

    if not verify then return true end
    return done
end

